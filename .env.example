# ============================================
# NAMING CONVENTION: passport-<service>
# Single shared platform serving all neighborhoods
# ============================================

# PostgreSQL connection string for the web app
PG_CONNECTION=postgresql://root:password@postgres:5432/pg

# Drizzle Gateway master password (change for production)
MASTERPASS=password

# Git revision for deployment tracking
GIT_REVISION=dev

# ============ DATABASE ============
DB_USER=root
DB_PASSWORD=password
DB_NAME=passport
DB_PORT=5432

# Drizzle Gateway master password (change for production)
DRIZZLE_MASTERPASS=password
DRIZZLE_GATEWAY_PORT=4983

# ============ WEB APP ============
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
BETTER_AUTH_URL=http://localhost:8000
BETTER_AUTH_SECRET=c94a90989040561858f261455d0e7fde0d905f7a2c39633d17d68b3712edf756

# File uploads directory (in-container volume)
UPLOADS_DIR=/app/uploads
